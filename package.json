{
  "name": "canopy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pages": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build:sw": "mkdir -p dist/background && cp src/background/service-worker.js dist/background/service-worker.js",
    "build": "npm run build:pages && npm run build:content && npm run build:sw",
    "dev": "npm run build",
    "test:vitest": "vitest run",
    "test:node": "find tests src -type f \\( -name '*.test.mjs' -o -name '*.test.js' -o -name '*.test.ts' \\) ! -path 'src/lib/account-state.test.ts' ! -path 'src/lib/editor-controller.test.ts' ! -path 'src/lib/sync-reconciliation.test.ts' -print0 | xargs -0 node --test",
    "test": "npm run test:vitest && npm run test:node"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.105.4",
    "@types/dompurify": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.2",
    "marked": "^15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.6"
  }
}
